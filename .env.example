# NEO - Face the Future
# Environment Configuration Template (Safe Non-Secret Defaults)

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# AI Hardware & Inference Engine
# Options for NEO_DEVICE: 'auto', 'cpu', 'cuda'
NEO_DEVICE=auto

# Active Model Strategy
# Options:
# - 'landmark-physiological-v1' (Fast, 100% identity-locked, 0-download, local CPU/GPU)
# - 'stabilityai/sd-turbo' (Single-step distilled SDXL diffusion inpainting)
# - 'runwayml/stable-diffusion-v1-5' (SD 1.5 inpainting)
NEO_ACTIVE_MODEL=landmark-physiological-v1

# Offline Mode (Prevents unexpected external network requests during inference)
NEO_OFFLINE_MODE=true

# Processing & Safety Limits
MAX_IMAGE_PAYLOAD_BYTES=15728640
MAX_PROCESSING_DIMENSION=1024
JOB_TTL_SECONDS=600

# Frontend Inference Endpoint
VITE_AI_INFERENCE_ENDPOINT=http://localhost:8000
