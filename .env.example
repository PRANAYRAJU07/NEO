# NEO - Face the Future
# Environment Configuration Template (Safe Non-Secret Defaults)

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# AI Hardware & Inference Engine
# Options for NEO_DEVICE: 'auto', 'cpu', 'cuda'
NEO_DEVICE=auto

# Engine choice:
# - landmark-physiological-v1: lightweight procedural processing, not generative AI.
# - stabilityai/sd-turbo: real local Diffusers image-to-image inference.
NEO_ACTIVE_MODEL=landmark-physiological-v1

# true = strict offline loading; weights must already be cached.
# false = allow one-time model downloads. Images are never sent for cloud inference.
NEO_OFFLINE_MODE=true
NEO_DIFFUSION_STEPS=4
# Optional custom model cache directory (blank uses Hugging Face default).
NEO_MODEL_CACHE_DIR=
# Do not silently switch to procedural effects if diffusion fails.
NEO_ALLOW_PROCEDURAL_FALLBACK=false

# Processing & Safety Limits
MAX_IMAGE_PAYLOAD_BYTES=15728640
MAX_PROCESSING_DIMENSION=1024
JOB_TTL_SECONDS=600

# Frontend Inference Endpoint
VITE_AI_INFERENCE_ENDPOINT=http://localhost:8000
